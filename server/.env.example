# ─────────────────────────────────────────────────────────────────────────────
# Pahadi Basera — Backend Server Environment Variables
# Copy this file to .env for local development or container deployment.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection URL (PostgreSQL)
# Local Docker Postgres: postgresql://postgres:password@localhost:5432/pahadi_basera?schema=public
# Cloud Postgres (Supabase, Neon, RDS, etc.): postgresql://<user>:<password>@<host>:5432/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/pahadi_basera?schema=public"

# Authentication & Security Secrets
# Generate random 32+ character secrets (e.g., using `openssl rand -hex 32`)
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_min_32_chars
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_min_32_chars
ENCRYPTION_KEY=your_optional_encryption_key_min_32_chars

# Docker Database Configuration (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=pahadi_basera
DB_PORT=5432
